APP_NAME=nready-api
APP_ENV=development
# Turns on the request echo in the response envelope, which carries the Authorization
# bearer token and CLIENT_API_KEYS. Never true in production.
APP_DEBUG=true
APP_TIMEZONE="Europe/Bucharest"
APP_URL=http://nready-api.test
APP_PORT=3000
APP_PORT_WHILE_TESTING=3001
APP_CURRENCY="RON"
# Contact address the app presents as its own.
APP_EMAIL="hello@example.com"

# Shipping rates, base currency. Prices are VAT-inclusive and apply to courier deliveries and
# returns; a relocation and a self-pickup are free. Operational costs are the starting estimate
# written onto each shipment. Defaults shown.
SHIPPING_DOMESTIC_COUNTRY="RO"
SHIPPING_PRICE_DOMESTIC=25
SHIPPING_PRICE_INTERNATIONAL=50
SHIPPING_OPERATIONAL_COST_DELIVERY=15
SHIPPING_OPERATIONAL_COST_RETURN=15
SHIPPING_OPERATIONAL_COST_RELOCATION=30

# Per-request timeout, and how long a shutdown waits before forcing exit. Both are read
# straight off process.env rather than through Configuration; defaults shown.
REQUEST_TIMEOUT=60000
FORCE_SHUTDOWN_TIMEOUT=10000

# Serve the generated API reference at /public/api-docs (opt-in). Must agree with the
# frontend's NEXT_PUBLIC_API_DOCS_ENABLED, which decides whether it renders the pages.
API_DOCS_ENABLED=true

FRONTEND_URL="http://nready-ui.test"
FRONTEND_APP_NAME="NReady"

# Browser origins allowed through CORS, comma separated. This is a browser-enforced policy,
# not an access control - a request without an Origin header (curl, any server-to-server
# caller) is always allowed through it. CLIENT_API_KEYS is what actually gates the API.
ALLOWED_ORIGINS="http://nready-ui.test"

APP_LANGUAGE_DEFAULT=en
APP_LANGUAGE_SUPPORTED=ro,en

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=nready-app
DB_USER=root
DB_PASSWORD="change-me"

# Shared with nready-ui: one instance, one database. REDIS_KEY_PREFIX is what keeps the two
# apart - it is applied in CacheProvider.buildKey, so keep the two prefixes different.
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=""
REDIS_PORT=6379
CACHE_TTL=60
REDIS_KEY_PREFIX=nready-api

# A member's comment is public the moment it is written; set to false to hold those for
# moderation too. A guest's comment always waits for a moderator, whatever this says.
COMMENT_AUTO_APPROVE=true

PINO_LOG_LEVEL=trace
PINO_LOG_EMAIL=you@example.com
PINO_LOG_TARGET=database

LOGGING_HISTORY="db"

# Only needed when MAIL_PROVIDER=ses or PINO_LOG_TARGET uses CloudWatch. AWS_SES_REGION
# falls back to AWS_REGION - an SES identity is verified per region, so the region that
# can send mail is not always the one the app runs in. An unset log stream defaults to
# the hostname, which keeps concurrent writers off a shared stream.
AWS_REGION=
AWS_SES_REGION=
AWS_CLOUDWATCH_LOG_GROUP=
AWS_CLOUDWATCH_LOG_STREAM=

MAIL_PROVIDER=smtp
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME="change-me"
MAIL_PASSWORD="change-me"
MAIL_FROM_ADDRESS="engine@example.com"
MAIL_FROM_NAME="NReady"

# Signs session tokens. The JWT carries the identity, but an account_token row is the source
# of truth for validity, so rotating this invalidates every live session.
AUTH_JWT_SECRET="change-me"
AUTH_JWT_EXPIRES_IN=86400
AUTH_JWT_REFRESH_EXPIRES_IN=28800

# A separate short-lived JWT for email confirmation links, unrelated to sessions.
EMAIL_JWT_SECRET="change-me"
EMAIL_JWT_EXPIRES_IN=30

# Keys the HMAC that turns a caller's address into `user_ip_hash`. Changing it makes every
# hash already stored unmatchable, so per-address limits (one rating per target, guest
# comment throttling) restart from zero.
IP_HASH_SECRET="change-me"

# Keys accepted in the `x-api-key` header of every request, `/health` and `/ready` excepted.
# This is the gate that makes the API private - without it the reader-facing /public/...
# modules answer anyone, since CORS does not apply to a caller that sends no Origin.
#
# Comma separated, and every entry is accepted, so a key rotates without a synchronised
# deploy: publish "old,new", move the clients across, then drop "old" in a second release.
#
# Empty disables the gate entirely, which is what a test run and a fresh checkout get; the
# app warns at boot when that happens in production.
#
# Must contain whatever nready-ui sends as REMOTE_API_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLIENT_API_KEYS="change-me"

# Social sign-in. The frontend runs the browser redirect; the code exchange happens here,
# so these secrets stay server-side. Leave a client id empty to disable that provider - the
# frontend hides any provider whose NEXT_PUBLIC_OAUTH_*_CLIENT_ID is unset, so the two
# configurations have to agree.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_API_VERSION=v21.0
# Extra redirect URI origins beyond FRONTEND_URL (comma separated); usually left empty.
OAUTH_REDIRECT_URI_ALLOW_LIST=

# Read only by the admin seed (src/features/account/database/admin.seed.ts), not at runtime.
ADMIN_NAME="Administrator"
